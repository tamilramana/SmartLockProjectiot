# ──────────────────────────────────────────────────────────────
# SmartLock – Environment Variables Template
# Copy this file to .env and fill in your own values.
# NEVER commit the actual .env file to source control.
# ──────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Security (CHANGE THESE before deploying!) ─────────────────
# JWT secret – sign with a long, random string in production
JWT_SECRET=CHANGE_ME_use_a_long_random_string_here

# AES-256 master key – exactly 32 ASCII characters
MASTER_KEY=0123456789abcdef0123456789abcdef

# ── HTTPS (optional) ──────────────────────────────────────────
# Set USE_HTTPS=true and provide paths to your PEM files
USE_HTTPS=false
SSL_KEY_PATH=./ssl/key.pem
SSL_CERT_PATH=./ssl/cert.pem

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins (leave blank to allow all)
ALLOWED_ORIGINS=http://localhost:3000

# ── MFA ───────────────────────────────────────────────────────
MFA_ISSUER=SmartLock
